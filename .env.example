# Local development template only. Values below are placeholders/defaults.
# Replace ISSUER_SIGNING_SECRET and API_ACCESS_TOKEN with secure random values
# in a deployment secret manager; never commit a populated .env file.
DATABASE_URL=sqlite:///./backend/bhashachain.db
ISSUER_SIGNING_SECRET=local-demo-only-change-me
ISSUER_KEY_ID=bhashachain-local-ed25519
TRUSTED_ISSUER_PUBLIC_KEYS_JSON={}
APP_ENV=development
API_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QPIAI_OPT_API_KEY=
QCLOUD_API_KEY=

# Explicitly disabled keeps writes local. Use "required" to fail closed unless the
# configured RightsLedger confirms and verifies every registration/update/revocation.
BLOCKCHAIN_MODE=disabled
BLOCKCHAIN_RPC_URL=
RIGHTS_LEDGER_ADDRESS=
BLOCKCHAIN_CHAIN_ID=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_SENDER_ADDRESS=
